{
	"info": {
		"name": "Harborline Provisions API",
		"description": "Auth + full CRUD for fleet, warehouses, inventory, orders and compliance certificates on the Harborline Provisions maritime supply chain platform.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "vessel_id",
			"value": ""
		},
		{
			"key": "warehouse_id",
			"value": ""
		},
		{
			"key": "inventory_id",
			"value": ""
		},
		{
			"key": "order_id",
			"value": ""
		},
		{
			"key": "certificate_id",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Restu Prasetyo\",\n  \"email\": \"restu@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"role\": \"buyer\"\n}"
						}
					}
				},
				{
					"name": "Login (admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@harborline.test\",\n  \"password\": \"password\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Step 1 of 2: this only sends a 6-digit code to the user's email",
									"// (MAIL_MAILER=log -> check storage/logs/laravel.log for the code).",
									"// Copy that code into 'Verify Login Code' below to actually get a token."
								]
							}
						}
					]
				},
				{
					"name": "Verify Login Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/login/verify",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@harborline.test\",\n  \"code\": \"123456\"\n}"
						},
						"description": "Step 2 of login. Use the 6-digit code emailed (or logged to storage/logs/laravel.log when MAIL_MAILER=log) after calling /login."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const data = pm.response.json();",
									"if (data.token) { pm.collectionVariables.set('token', data.token); }"
								]
							}
						}
					]
				},
				{
					"name": "Me",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": "{{base_url}}/me"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": "{{base_url}}/logout"
					}
				}
			]
		},
