APP_NAME="Harborline Provisions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=harborline_provisions
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:5173

# Login verification codes are sent through this mailer.
# MAIL_MAILER=log writes the email (including the 6-digit code) to
# storage/logs/laravel.log -- handy for local dev without real SMTP.
# Switch to smtp + real credentials (e.g. Mailtrap, Gmail app password,
# Resend, etc.) to actually deliver the email.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@harborline-provisions.test"
MAIL_FROM_NAME="${APP_NAME}"
